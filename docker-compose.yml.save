services:
  web:
    image: week9-app:1.2
    container_name: week9-web

    ports:
      - "3001:3000"

    restart: unless-stopped

    environment:
      APP_ENV: production

    security_opt:
      - no-new-privileges:true

    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://localhost:3000', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 3
